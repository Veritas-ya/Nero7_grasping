<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nero7_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configs for the Nero7 conveyor grasping system.</description>
  <maintainer email="ubuntu22@todo.todo">ubuntu22</maintainer>
  <license>MIT</license>

  <exec_depend>nero7_perception</exec_depend>
  <exec_depend>nero7_control</exec_depend>
  <exec_depend>agx_arm_description</exec_depend>
  <exec_depend>agx_arm_moveit</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
